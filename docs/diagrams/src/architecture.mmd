flowchart TB

subgraph TARGET["Embedded target"]
    direction TB

    APP["activity_node<br/>application workload"]

    subgraph EXP["Experiment and inference layer"]
        direction LR
        BACKEND["ST Edge AI<br/>inference backend"]
        BENCH["Benchmark harness<br/>GPDMA aggressor / null probe"]
        RUNTIME["Telemetry runtime"]
    end

    subgraph PLATFORM["Platform support"]
        direction LR
        DWT["Cortex-M33<br/>DWT counters"]
        MEM["STM32U5<br/>memory map"]
        IO["Sensors / audio"]
        UDP["UDP export"]
    end

    FW["STM32U585 firmware<br/>ThreadX + HAL"]

    APP --> BACKEND
    APP --> RUNTIME
    BENCH --> RUNTIME

    BACKEND --> MEM
    BENCH --> MEM
    RUNTIME --> DWT

    IO --> APP
    RUNTIME --> UDP

    FW --> APP
    FW --> BENCH
    FW --> PLATFORM
end

BOARD["B-U585I-IOT02A<br/>STM32U585 hardware"]

FW --> BOARD

subgraph HOST["Host software"]
    direction LR

    TUI["laxity-tui<br/>live / replay"]
    PARSER["telemetry_parse.py"]
    ANALYSE["analyse.py"]

    PARSER --> ANALYSE
end

BOARD -->|"telemetry stream"| TUI
BOARD -->|"captured telemetry"| PARSER

subgraph TOOLS["Experiment tooling"]
    direction LR

    DOCTOR["doctor.sh"]
    GENERATE["generate.sh"]
    BUILD["build.sh"]
    FLASH["flash.sh"]
    CAPTURE["capture.sh"]
    MONITOR["monitor.sh"]

    DOCTOR --> GENERATE
    GENERATE --> BUILD
    BUILD --> FLASH
    FLASH --> CAPTURE
end

FLASH -->|"program"| BOARD
CAPTURE -->|"record"| PARSER
MONITOR -->|"observe"| BOARD

