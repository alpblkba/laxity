CREDENTIALS = Path("firmware/stm32u585/Inc/wifi_credentials.h")
PLACEHOLDER = re.compile(r"REPLACE_ME|CHANGE_?ME|YOUR_?SSID", re.I)


def wifi_interface():
    """the Wi-Fi device name, from the system rather than assumed to be en0."""
    if not IS_MAC:
        return None
    text = capture(["networksetup", "-listallhardwareports"])
    block = None
    for line in text.splitlines():
        if line.startswith("Hardware Port:"):
            block = line.split(":", 1)[1].strip()
        elif line.startswith("Device:") and block == "Wi-Fi":
            return line.split(":", 1)[1].strip()
    return None


def host_ssid(iface):
    """the SSID this host is on, or None with the reason.

    three sources are tried in order and each one is validated rather than trusted. the old
    airport binary is not among them: it is gone from current macOS. recent macOS also withholds
    the SSID from a process without Location Services authorisation, and it does so by answering
    rather than by failing, so "not associated" and a literal "<redacted>" both have to be caught
    or the CLI would write one of them into a header as if it were a network name.
    """
    tried = []

    if iface:
        text = capture(["networksetup", "-getairportnetwork", iface])
        tried.append("networksetup -getairportnetwork %s" % iface)
        match = re.search(r"Current Wi-?Fi Network:\s*(.+?)\s*$", text, re.M)
        if match and "redacted" not in match.group(1).lower():
            return match.group(1), None

        text = capture(["ipconfig", "getsummary", iface])
        tried.append("ipconfig getsummary %s" % iface)
        match = re.search(r"^\s*SSID\s*:\s*(.+?)\s*$", text, re.M)
        if match and "redacted" not in match.group(1).lower():
            return match.group(1), None

    text = capture(["system_profiler", "SPAirPortDataType"], timeout=40)
    tried.append("system_profiler SPAirPortDataType")
    match = re.search(r"Current Network Information:\s*\n\s*(.+?):\s*$", text, re.M)
    if match and "redacted" not in match.group(1).lower():
        return match.group(1), None

    return None, ("the SSID could not be read. tried: %s. current macOS returns <redacted> or "
                  "reports no association unless the calling program has Location Services "
                  "permission, so grant it to this terminal or pass --ssid." % "; ".join(tried))


def host_address(iface):
    """this host's address on that interface, which is where the board should send."""
    if iface:
        text = capture(["ipconfig", "getifaddr", iface]).strip()
        if re.fullmatch(r"\d+\.\d+\.\d+\.\d+", text):
            return text
    probe = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        probe.connect(("192.0.2.1", 9))
        return probe.getsockname()[0]
    except OSError:
        return None
    finally:
        probe.close()


def read_credentials():
    path = ROOT / CREDENTIALS
    if not path.exists():
        return None
    text = path.read_text()
    ssid = re.search(r'#define\s+LAXITY_WIFI_SSID\s+"([^"]*)"', text)
    port = re.search(r"#define\s+LAXITY_TELEMETRY_PORT\s+(\d+)", text)
    return {
        "ssid": ssid.group(1) if ssid else None,
        "port": int(port.group(1)) if port else 50505,
        "text": text,
    }


def write_credentials(ssid, password, address, port):
    """the header the firmware includes, with both strings quoted.

    the quotes are not cosmetic. an unquoted SSID reaches the preprocessor as an identifier and
    the build fails with an undeclared identifier a long way from this file, which has already
    happened once on this project.
    """
    octets = ", ".join(address.split("."))
    body = (
        "/* network credentials and the telemetry destination, kept out of the repository.\n"
        " *\n"
        " * written by tools/laxity. this file is ignored by git on purpose.\n"
        " */\n"
        "#ifndef LAXITY_WIFI_CREDENTIALS_H\n"
        "#define LAXITY_WIFI_CREDENTIALS_H\n"
        "\n"
        '#define LAXITY_WIFI_SSID       "%s"\n'
        '#define LAXITY_WIFI_PASSWORD   "%s"\n'
        "\n"
        "/* the host running the receiver, as it appeared on this network when this was written. */\n"
        "#define LAXITY_TELEMETRY_IP4   %s\n"
        "#define LAXITY_TELEMETRY_PORT  %d\n"
        "\n"
        "#endif /* LAXITY_WIFI_CREDENTIALS_H */\n"
    ) % (ssid.replace("\\", "\\\\").replace('"', '\\"'),
         password.replace("\\", "\\\\").replace('"', '\\"'),
         octets, port)
    (ROOT / CREDENTIALS).write_text(body)


def security_note():
    """what the code actually does about security type, read out of the driver.

    reported rather than assumed, because an open network is the case most likely to be reached
    during a demonstration and the one least likely to have been tried.
    """
    cube = Path(os.environ.get("LAXITY_CUBE_U5",
                               Path.home() / "STM32Cube/Repository/STM32Cube_FW_U5_V1.8.0"))
    driver = cube / "Middlewares/ST/netxduo/common/drivers/wifi/mxchip/nx_driver_emw3080.c"
    if not driver.exists():
        return None, "the open network path was not verified: %s is not on this host" % driver
    for number, line in enumerate(driver.read_text(errors="replace").splitlines(), 1):
        if "MX_WIFI_Connect(" in line and "MX_WIFI_SEC_" in line:
            mode = re.search(r"MX_WIFI_SEC_\w+", line).group(0)
            if mode == "MX_WIFI_SEC_AUTO":
                return True, ("security type is %s at %s:%d, so the module reads it from the scan "
                              "result and an open network resolves to MX_WIFI_SEC_NONE without "
                              "anything here setting it" % (mode, driver.name, number))
            return False, ("the open network path was not verified: the driver hard codes %s at "
                           "%s:%d instead of detecting it" % (mode, driver.name, number))
    return None, "the open network path was not verified: no MX_WIFI_Connect call found in %s" % driver.name


def net_enabled():
    """whether the image even contains the network thread, and which line says so."""
    path = ROOT / "firmware/stm32u585/Src/app_threadx.c"
    for number, line in enumerate(path.read_text(errors="replace").splitlines(), 1):
        match = re.match(r"\s*#define\s+LAXITY_NET_ENABLE\s+(\d+)", line)
        if match:
            return match.group(1) != "0", number
    return None, None


def watch_serial(port, seconds):
    """the board's own account of the link, from the status line it already prints."""
    timeout = shutil.which("timeout") or shutil.which("gtimeout")
    if not timeout:
        return None, "no timeout(1) or gtimeout(1) on PATH, install coreutils"
    subprocess.call(["stty", "-f", port, "921600", "raw", "-echo"], stderr=subprocess.DEVNULL)
    text = capture([timeout, str(seconds), "cat", port], timeout=seconds + 10)
    for line in text.splitlines():
        if line.startswith("net rc="):
            return line.strip(), None
    if "net disabled" in text:
        return "net disabled", None
    return None, "no net line appeared on %s in %ds" % (port, seconds)


def wait_for_udp(port, seconds):
    """whether anything actually arrived here, which association does not imply."""
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    try:
        sock.bind(("0.0.0.0", port))
    except OSError as err:
        sock.close()
        return 0, "could not bind udp/%d: %s" % (port, err)
    sock.settimeout(1.0)
    deadline, count = time.time() + seconds, 0
    try:
        while time.time() < deadline:
            try:
                data, _ = sock.recvfrom(2048)
            except socket.timeout:
                continue
            if data:
                count += 1
    finally:
        sock.close()
    return count, None


def cmd_wifi(args):
    head("credentials")
    existing = read_credentials()
    ssid = args.ssid
    password = args.password
    port = existing["port"] if existing else 50505

    if ssid is None and existing and existing["ssid"] and not PLACEHOLDER.search(existing["ssid"]):
        ssid = existing["ssid"]
        say("  the board is already configured for %s, using that" % ssid)
        password = None
    else:
        iface = wifi_interface()
        say("  Wi-Fi interface: %s" % (iface or "not found"))
        if ssid is None:
            ssid, why = host_ssid(iface)
            if ssid is None:
                die("  " + why)
            say("  this host is on %s, joining that" % ssid)
        if password is None:
            if not sys.stdin.isatty():
                die("  no password given and this is not a terminal. pass --password, or "
                    "--password '' for an open network.")
            import getpass
            password = getpass.getpass("  password for %s (empty for an open network): " % ssid)

        address = args.host or host_address(wifi_interface())
        if not address:
            die("  this host has no address on that network, so there is nowhere to send to.")
        write_credentials(ssid, password, address, port)
        say("  wrote %s, destination %s:%d" % (CREDENTIALS, address, port))

    verified, note = security_note()
    say("  %s" % note)

    enabled, line_no = net_enabled()
    if enabled is False:
        head("result")
        say("  1. association and DHCP     not attempted")
        say("  2. UDP reached this host    not attempted")
        say()
        say("  the firmware in this tree has the network path compiled out: LAXITY_NET_ENABLE is 0")
        say("  at firmware/stm32u585/Src/app_threadx.c:%d, so the NetX Duo thread is never" % line_no)
        say("  started and neither observation can be made. the credentials above are in place and")
        say("  take effect the first time that define is 1 and the image is rebuilt.")
        return 2

    if args.write_only:
        say("  stopping after writing the credentials, as asked")
        return 0

    head("build and flash")
    if call(["./tools/stm32/build.sh"]) != 0:
        die("build failed")
    boards, _ = discover(identify=False)
    board = choose(boards, args.board)
    if call(["./tools/stm32/flash.sh"], env=board_env(board)) != 0:
        die("flash failed")

    head("watching")
    say("  listening on udp/%d and reading %s for %ds" % (port, board.port, args.seconds))
    count, bind_error = wait_for_udp(port, args.seconds)
    line, serial_error = watch_serial(board.port, 8) if board.port else (None, "no serial port")

    associated = bool(line and line.startswith("net rc=") and "ip=0.0.0.0" not in line)

    head("result")
    if associated:
        say("  1. association and DHCP     %syes%s   %s" % (GREEN, RESET, line))
    else:
        say("  1. association and DHCP     %sno%s    %s" % (RED, RESET, line or serial_error))
    if count:
        say("  2. UDP reached this host    %syes%s   %d datagrams on udp/%d" % (GREEN, RESET, count, port))
    else:
        say("  2. UDP reached this host    %sno%s    %s" % (RED, RESET, bind_error or "nothing arrived"))
    if associated and not count:
        say()
        say("  the board joined and took an address, and nothing reached this host. that is the")
        say("  normal shape of a captive portal guest network, which lets a client associate and")
        say("  then drops its traffic until a browser has agreed to something.")
    return 0 if (associated and count) else 1


# entry point ---------------------------------------------------------------------------------

def main():
    parser = argparse.ArgumentParser(prog="laxity", description=__doc__.splitlines()[0])
    subs = parser.add_subparsers(dest="command")

    def add(name, func, help_text):
        sub = subs.add_parser(name, help=help_text)
        sub.set_defaults(func=func)
        return sub

    sub = add("doctor", cmd_doctor, "toolchain check and board discovery")
    sub.add_argument("--no-identify", action="store_true",
                     help="skip the connection that reads the part number")

    sub = add("boards", cmd_boards, "the boards attached, with port and profile")
    sub.add_argument("--no-identify", action="store_true",
                     help="skip the connection that reads the part number")

    add("build", cmd_build, "build the firmware")

    sub = add("flash", cmd_flash, "flash the built firmware")
    sub.add_argument("--board", help="ST-LINK serial number")

    sub = add("capture", cmd_capture, "record a telemetry run")
    sub.add_argument("--board", help="ST-LINK serial number")
    sub.add_argument("--seconds", type=int, default=60)
    sub.add_argument("--out", default="run", help="run name, appended to the timestamp")

    sub = add("analyse", cmd_analyse, "turn a capture into the results document")
    sub.add_argument("capture", nargs="?", help="capture directory, newest if omitted")

    sub = add("run", cmd_run, "build, flash, capture and analyse")
    sub.add_argument("--board", help="ST-LINK serial number")
    sub.add_argument("--seconds", type=int, default=60)
    sub.add_argument("--out", default="run", help="run name, appended to the timestamp")

    sub = add("tui", cmd_tui, "the live viewer, or a recorded capture")
    sub.add_argument("--board", help="ST-LINK serial number")
    sub.add_argument("--file", help="read a capture instead of a board")

    sub = add("sim", cmd_sim, "replay a scenario from the simulator into the viewer")
    sub.add_argument("scenario", help="name under scenarios/, without the extension")
    sub.add_argument("--seed", type=int, default=1)
    sub.add_argument("--port", type=int, default=50505)

    sub = add("audit", cmd_audit, "audit declared memory placement without a board")
    sub.add_argument("config", nargs="?", help="laxity.toml, defaults to the current directory")
    sub.description = "audit declared objects and requester endpoints against a linker map"
    sub.epilog = (
        "does not discover objects; it reads laxity.toml\n"
        "does not apply a plan; laxity plan does that\n"
        "does not measure the target; laxity characterise does that\n"
        "does not resolve placement below a region"
    )
    sub.formatter_class = argparse.RawDescriptionHelpFormatter

    sub = add("wifi", cmd_wifi, "put the board on a network and report what actually worked")
    sub.add_argument("--board", help="ST-LINK serial number")
    sub.add_argument("--ssid", help="network to join, otherwise the one this host is on")
    sub.add_argument("--password", help="network password, empty string for an open network")
    sub.add_argument("--host", help="address the board should send to, otherwise this host's")
    sub.add_argument("--seconds", type=int, default=30, help="how long to wait for datagrams")
    sub.add_argument("--write-only", action="store_true",
                     help="write the credentials and stop, do not build or flash")

    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        return 0
    os.chdir(ROOT)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main() or 0)
